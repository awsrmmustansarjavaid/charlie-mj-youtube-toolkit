# Charlie MJ YouTube Toolkit
# Git ignore rules for a static GitHub Pages project.
# This repository has no build output requirement, but these rules keep local tooling noise out of Git.

# Operating-system metadata.
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE settings.
.vscode/
.idea/
*.swp
*.swo

# Node/package-manager artifacts used only if optional frontend tooling is introduced locally.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Optional local build/cache directories.
dist/
build/
.cache/
.parcel-cache/

# Local environment files must never be committed if they contain private configuration.
.env
.env.*
!.env.example

# Personal application exports/session backups.
.local-data/
*.session.json
*.backup.json
