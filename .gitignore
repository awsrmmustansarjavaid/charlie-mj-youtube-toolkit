# Charlie MJ YouTube Toolkit — Git ignore rules
# Ignore operating-system metadata created by Windows/macOS/Linux.
.DS_Store
Thumbs.db
Desktop.ini

# Ignore editor and IDE metadata that should not be committed.
.vscode/
.idea/
*.swp
*.swo

# Ignore local dependency/build directories if a future desktop wrapper is added.
node_modules/
dist/
build/

# Ignore local environment/secret files. Never commit API keys or passwords.
.env
.env.*
!.env.example

# Ignore generated desktop/package artifacts when experimenting locally.
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.zip

# Ignore temporary logs and cache files.
*.log
.cache/
.tmp/
